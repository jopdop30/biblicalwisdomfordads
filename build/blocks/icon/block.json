{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bwfd/icon",
  "version": "1.0.0",
  "title": "Icon",
  "category": "bwfd",
  "icon": "star-empty",
  "description": "One of the theme's line icons, plain or in an apricot circle.",
  "keywords": [
    "icon",
    "symbol",
    "svg"
  ],
  "textdomain": "bwfd",
  "attributes": {
    "icon": {
      "type": "string",
      "default": "compass"
    },
    "variant": {
      "type": "string",
      "default": "plain"
    },
    "size": {
      "type": "number",
      "default": 34
    }
  },
  "supports": {
    "html": false,
    "color": {
      "text": true,
      "background": false,
      "link": false
    }
  },
  "example": {
    "attributes": {
      "icon": "book",
      "variant": "circle"
    }
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}