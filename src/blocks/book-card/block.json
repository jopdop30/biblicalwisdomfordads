{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bwfd/book-card",
	"version": "1.0.0",
	"title": "Book card",
	"category": "bwfd",
	"icon": "book",
	"description": "A compact card for the book: cover, title, a line of text and a buy button, drawn from Settings → Structured data so the price stays current. Sticky beside an article.",
	"keywords": [
		"book",
		"buy",
		"sidebar",
		"cover",
		"card"
	],
	"textdomain": "bwfd",
	"attributes": {
		"accent": {
			"type": "string",
			"default": "blue"
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"buttonLabel": {
			"type": "string",
			"default": ""
		},
		"buttonUrl": {
			"type": "string",
			"default": ""
		},
		"showPrice": {
			"type": "boolean",
			"default": false
		},
		"linkLabel": {
			"type": "string",
			"default": ""
		},
		"linkUrl": {
			"type": "string",
			"default": ""
		},
		"sticky": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"anchor": true,
		"html": false,
		"align": false,
		"spacing": {
			"margin": [
				"top",
				"bottom"
			]
		}
	},
	"example": {
		"attributes": {
			"accent": "apricot",
			"showPrice": true
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
