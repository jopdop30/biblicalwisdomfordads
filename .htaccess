# Long-lived browser caching for the theme's static assets. Fonts and imagery
# do not change between releases (a changed image gets a new file name), so
# a year is safe; stylesheets and scripts keep the server default because
# they are referenced with a version query string that only changes on release.
<IfModule mod_mime.c>
	AddType image/webp .webp
	AddType font/woff2 .woff2
</IfModule>
<IfModule mod_expires.c>
	ExpiresActive On
	ExpiresByType font/woff2 "access plus 1 year"
	ExpiresByType image/webp "access plus 1 year"
	ExpiresByType image/png "access plus 1 year"
	ExpiresByType image/svg+xml "access plus 1 year"
	ExpiresByType image/x-icon "access plus 1 year"
	ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
	<FilesMatch "\.(woff2|webp|png|svg|ico)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>
